# Google Search Console MCP Server — Environment Variables Template
# Copy this file to .env and fill in your real values

# ─────────────────────────────────────────────────────────────────
# Google Cloud OAuth 2.0 Credentials
# Create at: https://console.cloud.google.com → APIs & Services → Credentials
# ─────────────────────────────────────────────────────────────────
CLIENT_ID=your-google-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=https://your-app.vercel.app/api/auth/callback

# ─────────────────────────────────────────────────────────────────
# Turso Database (Cloud SQLite)
# Sign up free at: https://turso.tech
#   turso db show your-db-name        → gets the URL
#   turso db tokens create your-db    → gets the token
# ─────────────────────────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
