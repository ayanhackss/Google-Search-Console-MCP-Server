<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Google Search Console MCP</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { 
            font-family: 'Outfit', sans-serif;
            background: radial-gradient(circle at top, #13182b, #050505 80%);
            color: #fafafa; 
            overflow-x: hidden;
        }
        .glow-bg {
            position: absolute;
            width: 800px;
            height: 800px;
            background: radial-gradient(circle, rgba(59,130,246,0.15) 0%, rgba(0,0,0,0) 70%);
            top: -300px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 0;
            pointer-events: none;
        }
        .glass-card { 
            background: rgba(20, 24, 39, 0.6); 
            backdrop-filter: blur(20px); 
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.08); 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255,255,255,0.1);
            position: relative;
            z-index: 10;
        }
        .animate-fade-up { 
            animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards; 
        }
        @keyframes fadeUp { 
            from { opacity: 0; transform: translateY(30px); } 
            to { opacity: 1; transform: translateY(0); } 
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 relative">
    <div class="glow-bg"></div>
    
    <div class="glass-card max-w-xl w-full p-10 rounded-[2rem] text-center space-y-8 animate-fade-up">
        
        <div class="space-y-4">
            <div class="inline-block px-3 py-1 rounded-full bg-blue-500/10 border border-blue-500/20 text-blue-400 text-xs font-semibold tracking-wide uppercase mb-4">
                Model Context Protocol
            </div>
            <h1 class="text-4xl md:text-5xl font-bold tracking-tight text-white leading-tight">
                Connect your AI to <br/>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-500">Google Search Console</span>
            </h1>
            <p class="text-gray-400 text-lg font-light leading-relaxed max-w-md mx-auto pt-2">
                Give your AI agents secure, instant access to your live SEO performance data, indexing status, and sitemaps.
            </p>
        </div>
        
        <div class="pt-6">
            <button id="authBtn" class="group relative inline-flex items-center justify-center gap-3 px-8 py-4 bg-white text-gray-900 font-semibold rounded-xl overflow-hidden transition-transform hover:scale-[1.02] active:scale-[0.98] w-full sm:w-auto shadow-[0_0_20px_rgba(255,255,255,0.2)]">
                <!-- Google Logo SVG -->
                <svg class="w-5 h-5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                    <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                    <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                    <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
                <span class="text-base" id="btnText">Sign in with Google</span>
            </button>
            <p class="text-xs text-gray-500 font-light mt-4">
                Secure, isolated, and strictly read-only access.
            </p>
        </div>
    </div>

    <script>
        document.getElementById('authBtn').addEventListener('click', async () => {
            const btn = document.getElementById('authBtn');
            const btnText = document.getElementById('btnText');
            btn.disabled = true;
            btnText.textContent = 'Connecting...';
            btn.classList.add('opacity-80', 'cursor-not-allowed');

            try {
                // Silently generate the API key in the background
                const response = await fetch('/api/register', { method: 'POST' });
                const data = await response.json();

                if (data.success) {
                    // Redirect straight to Google OAuth with the new apiKey
                    window.location.href = `/api/auth/login?apiKey=${data.apiKey}`;
                } else {
                    alert('Error: ' + data.error);
                    btn.disabled = false;
                    btnText.textContent = 'Sign in with Google';
                    btn.classList.remove('opacity-80', 'cursor-not-allowed');
                }
            } catch (err) {
                alert('Network error occurred.');
                btn.disabled = false;
                btnText.textContent = 'Sign in with Google';
                btn.classList.remove('opacity-80', 'cursor-not-allowed');
            }
        });
    </script>
</body>
</html>
